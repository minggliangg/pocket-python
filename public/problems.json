  {
    "id": "valid-anagram",
    "title": "Valid Anagram",
    "difficulty": "Easy",
    "fnName": "is_anagram",
    "prompt": "Given two strings s and t, return True if t is an anagram of s (same characters with the same counts), otherwise False.",
    "signature": "def is_anagram(s, t):",
    "starter": "def is_anagram(s, t):\n    pass\n",
    "examples": [
      {
        "input": "s = 'anagram', t = 'nagaram'",
        "output": "True"
      }
    ],
    "tests": [
      {
        "label": "Classic anagram",
        "args": [
          "anagram",
          "nagaram"
        ],
        "expected": true
      },
      {
        "label": "Different letters",
        "args": [
          "rat",
          "car"
        ],
        "expected": false
      },
      {
        "label": "Length mismatch",
        "args": [
          "a",
          "ab"
        ],
        "expected": false
      },
      {
        "label": "Same word",
        "args": [
          "listen",
          "silent"
        ],
        "expected": true
      }
    ],
    "solution": "def is_anagram(s, t):\n    if len(s) != len(t):\n        return False\n    counts = {}\n    for ch in s:\n        counts[ch] = counts.get(ch, 0) + 1\n    for ch in t:\n        if ch not in counts:\n            return False\n        counts[ch] -= 1\n        if counts[ch] < 0:\n            return False\n    return True\n",
    "packId": "core"
  },
  {
    "id": "best-time-to-sell",
    "title": "Best Time to Buy and Sell Stock",
    "difficulty": "Easy",
    "fnName": "max_profit",
    "prompt": "Given a list prices where prices[i] is the stock price on day i, return the maximum profit from one buy and one later sell. If no profit is possible, return 0.",
    "signature": "def max_profit(prices):",
    "starter": "def max_profit(prices):\n    pass\n",
    "examples": [
      {
        "input": "prices = [7, 1, 5, 3, 6, 4]",
        "output": "5"
      }
    ],
    "tests": [
      {
        "label": "Wave up",
        "args": [
          [
            7,
            1,
            5,
            3,
            6,
            4
          ]
        ],
        "expected": 5
      },
      {
        "label": "Only falling",
        "args": [
          [
            7,
            6,
            4,
            3,
            1
          ]
        ],
        "expected": 0
      },
      {
        "label": "Two days",
        "args": [
          [
            1,
            2
          ]
        ],
        "expected": 1
      },
      {
        "label": "Flat",
        "args": [
          [
            5,
            5,
            5
          ]
        ],
        "expected": 0
      }
    ],
    "solution": "def max_profit(prices):\n    min_price = float('inf')\n    best = 0\n    for price in prices:\n        if price < min_price:\n            min_price = price\n        elif price - min_price > best:\n            best = price - min_price\n    return best\n",
    "packId": "core"
  },
  {
    "id": "maximum-subarray",
    "title": "Maximum Subarray",
    "difficulty": "Medium",
    "fnName": "max_subarray",
    "prompt": "Given a list of integers nums, return the largest sum of any contiguous non-empty subarray.",
    "signature": "def max_subarray(nums):",
    "starter": "def max_subarray(nums):\n    pass\n",
    "examples": [
      {
        "input": "nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]",
        "output": "6"
      }
    ],
    "tests": [
      {
        "label": "Classic",
        "args": [
          [
            -2,
            1,
            -3,
            4,
            -1,
            2,
            1,
            -5,
            4
          ]
        ],
        "expected": 6
      },
      {
        "label": "Single",
        "args": [
          [
            1
          ]
        ],
        "expected": 1
      },
      {
        "label": "All negative",
        "args": [
          [
            -3,
            -2,
            -5
          ]
        ],
        "expected": -2
      },
      {
        "label": "Whole array",
        "args": [
          [
            5,
            4,
            -1,
            7,
            8
          ]
        ],
        "expected": 23
      }
    ],
    "solution": "def max_subarray(nums):\n    best = current = nums[0]\n    for n in nums[1:]:\n        current = max(n, current + n)\n        best = max(best, current)\n    return best\n",
    "packId": "core"
