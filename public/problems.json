  {
    "id": "two-sum",
    "title": "Two Sum",
    "difficulty": "Easy",
    "fnName": "two_sum",
    "prompt": "Given a list of integers nums and an integer target, return the indices of the two numbers that add up to target. You may assume exactly one solution exists, and you may not use the same element twice. Return the indices in ascending order.",
    "signature": "def two_sum(nums, target):",
    "starter": "def two_sum(nums, target):\n    # Return [i, j] with i < j\n    pass\n",
    "examples": [
      {
        "input": "nums = [2, 7, 11, 15], target = 9",
        "output": "[0, 1]"
      }
    ],
    "tests": [
      {
        "label": "Example pair",
        "args": [
          [
            2,
            7,
            11,
            15
          ],
          9
        ],
        "expected": [
          0,
          1
        ]
      },
      {
        "label": "Mid array",
        "args": [
          [
            3,
            2,
            4
          ],
          6
        ],
        "expected": [
          1,
          2
        ]
      },
      {
        "label": "Duplicates",
        "args": [
          [
            3,
            3
          ],
          6
        ],
        "expected": [
          0,
          1
        ]
      },
      {
        "label": "Negatives",
        "args": [
          [
            -1,
            -2,
            -3,
            -4,
            -5
          ],
          -8
        ],
        "expected": [
          2,
          4
        ]
      }
    ],
    "solution": "def two_sum(nums, target):\n    seen = {}\n    for i, n in enumerate(nums):\n        if target - n in seen:\n            return [seen[target - n], i]\n        seen[n] = i\n",
    "packId": "core"
  },
  {
    "id": "contains-duplicate",
    "title": "Contains Duplicate",
    "difficulty": "Easy",
    "fnName": "contains_duplicate",
    "prompt": "Given a list of integers nums, return True if any value appears at least twice, otherwise False.",
    "signature": "def contains_duplicate(nums):",
    "starter": "def contains_duplicate(nums):\n    pass\n",
    "examples": [
      {
        "input": "nums = [1, 2, 3, 1]",
        "output": "True"
      }
    ],
    "tests": [
      {
        "label": "Has duplicate",
        "args": [
          [
            1,
            2,
            3,
            1
          ]
        ],
        "expected": true
      },
      {
        "label": "All unique",
        "args": [
          [
            1,
            2,
            3,
            4
          ]
        ],
        "expected": false
      },
      {
        "label": "Many repeats",
        "args": [
          [
            1,
            1,
            1,
            3,
            3,
            4,
            3,
            2,
            4,
            2
          ]
        ],
        "expected": true
      },
      {
        "label": "Single element",
        "args": [
          [
            7
          ]
        ],
        "expected": false
      }
    ],
    "solution": "def contains_duplicate(nums):\n    seen = set()\n    for n in nums:\n        if n in seen:\n            return True\n        seen.add(n)\n    return False\n",
